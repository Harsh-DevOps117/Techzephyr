NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/techzephyr
RABBITMQ_URL=amqp://guest:guest@localhost:5672
ALLOWED_ORIGIN=http://localhost:3001,http://localhost:8080
DATA_ROOT=./data
VALIDATOR_PATH=./validator.py
PYTHON_BIN=python3
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Development-only signing secret. Replace before any shared deployment.
JWT_SECRET=replace-this-development-secret-before-production
REDIS_URL=redis://localhost:6379
CACHE_DEFAULT_TTL_SECONDS=60
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
