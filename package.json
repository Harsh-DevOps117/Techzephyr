{
  "name": "techzephyr4-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CIT scheduling API, PostgreSQL persistence, and RabbitMQ workers",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/interfaces/http/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/interfaces/http/server.js",
    "worker": "tsx src/interfaces/workers/worker.ts",
    "worker:start": "node dist/interfaces/workers/worker.js",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "amqplib": "^0.10.8",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "jose": "^6.2.14",
    "openai": "^7.47.0",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "uuid": "^13.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
